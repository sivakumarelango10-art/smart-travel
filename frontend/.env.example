# ==============================================================================
# SmartTravel Frontend Environment Configuration
# Copy this file to .env and fill in values for local development.
# In production (Vercel), set these as Environment Variables in the Vercel dashboard.
# ==============================================================================

# Backend REST API base URL
# Development: http://localhost:8080/api/v1
# Production:  https://<your-render-service>.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Backend WebSocket base URL
# Development: ws://localhost:8080/ws
# Production:  wss://<your-render-service>.onrender.com/ws
VITE_WS_BASE_URL=ws://localhost:8080/ws

# Razorpay PUBLIC Key ID (safe to expose to frontend — this is NOT the secret)
# Get from: Razorpay Dashboard → Settings → API Keys
# Development: rzp_test_...
# Production:  rzp_live_...
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# Swagger API documentation URL (optional, leave blank to disable the link)
# Production: leave blank or omit (Swagger is disabled in prod profile)
VITE_SWAGGER_URL=http://localhost:8080/swagger-ui.html

# Google Identity Services (OAuth 2.0 Web Client ID)
# Get from: Google Cloud Console → APIs & Services → Credentials
# Development & Production Web Client ID (Public identifier)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

