# ==============================================================================
# SmartTravel Platform - Backend Environment Variables
# ==============================================================================

# Server & Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MongoDB Connection
# For local MongoDB instance:
MONGODB_URI=mongodb://localhost:27017/smarttravel_dev
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smarttravel?retryWrites=true&w=majority

# JWT Security Secrets (Base64 encoded 512-bit key)
JWT_SECRET=dGhpcy1pcy1hLXNhbXBsZS01MTItYml0LXNlY3JldC1rZXktZm9yLXVzZS13aXRoLWpqd3Qtc21hcnR0cmF2ZWwtYXBwbGljYXRpb24tZGV2ZWxvcG1lbnQtdGVzdGluZw==
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Business Engine Configurations
PRICE_FREEZE_DURATION_MINUTES=30
MOCK_PAYMENT_AUTO_APPROVE=true

# Razorpay Payment Gateway
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_CURRENCY=INR

# Google Identity Services (OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Google Gemini AI (backend-only — NEVER expose in VITE_ prefix or frontend code)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=6
